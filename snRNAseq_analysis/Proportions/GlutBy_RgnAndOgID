###======== ANALYSIS
## STACKPLOTS
```{r}
metaUse <- FetchData(seuObj, vars = c("RegionAcronym", "clusterName3", "cn3_class", "orig.ident"))
metaUse$RegionAcronym <- factor(metaUse$RegionAcronym , levels = lvl_order)
metaUse$clusterName3 <- factor(metaUse$clusterName3 , levels = dendro_order_3)

stackedbarplot_colors(metaUse,"clusterName3", "RegionAcronym",
                      custom_colors = region_colors, 
                      level_order = lvl_order)

gluts <- coarse_lvl$Cluster[coarse_lvl$Class == "Glutamatergic" &
                              coarse_lvl$Subclass != "Neurogenic"]
metaUse_gluts <- filter(metaUse, clusterName3 %in% gluts)
stackedbarplot_colors(metaUse_gluts,"clusterName3", "RegionAcronym",
                      custom_colors = region_colors, 
                      level_order = lvl_order)

# order by rgn of origin
glutLvls_byRgnPct <- c("Glut-RA(19)", "Glut-RA(18)", "Glut-ArcoPall(27)", "Glut-Arco(1)", "Glut-Arco(10)",
                       "Glut-HVC(7)", "Glut-HVC(8)", "Glut-NidoHyperPall(28)", "Glut-NidoHyperPall(23)",
                       "Glut-NidoHyperPall(24)", "Glut-NidoHyperPall(26)", "Glut-NidoHyperPall(20)",
                       "Glut-LMAN(44)", "Glut-LMAN(45)",
                       "Glut(21)", 
                       "Glut-NidoHyperPall(25)", "Glut-Hyper(9)",
                       "Glut-MesoPall(6)", "Glut-MesoPall(5)", "Glut-MesoPall(29)", "Glut-MesoPall(30)",  "Glut-MesoPall(2)"
                                              )

metaUse_gluts$clusterName3 <- factor(metaUse_gluts$clusterName3 , levels = glutLvls_byRgnPct)
glutsClust_byRgn <- stackedbarplot_colors(metaUse_gluts,"clusterName3", "RegionAcronym",
                                          custom_colors = region_colors, 
                                          level_order = lvl_order)
ggsave(file.path(Figures_dir, "stkPlt_glutsMature_colRgn.svg"), plot = glutsClust_byRgn,
       width = 5, height = 4.5)

glutsClust_byOgId <- stackedbarplot_colors(metaUse_gluts,"clusterName3", "orig.ident",
                                            custom_colors = origIdent_colors, 
                                            level_order = origIdent_lvls)
