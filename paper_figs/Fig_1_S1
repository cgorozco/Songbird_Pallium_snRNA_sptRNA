# Significance test of location
```{r}
metaStats <- metaToPlot %>%
  select(clusterName3, RegionAcronym, BirdID) %>%
  group_by(clusterName3) %>%
  mutate(ClstrCount = n()) %>%
  group_by(clusterName3, RegionAcronym, BirdID) %>%
  mutate(ClstrRgnNbyID = n()) %>%
  mutate(Prop = ClstrRgnNbyID / ClstrCount) %>%
  ungroup() %>%
  complete(clusterName3, nesting(RegionAcronym, BirdID), fill = list(Prop = 0)) %>%
  unique()

#-- Calculate Z-score based on median and MAD
results_list <- list()
for (cluster in unique(metaStats$clusterName3)) {
  cluster_data <- metaStats %>% filter(clusterName3 == cluster)

  medians <- cluster_data %>%
    group_by(RegionAcronym) %>%
    summarise(median_value = median(Prop))

  overall_median <- median(cluster_data$Prop)
  overall_mad <- mad(cluster_data$Prop)

  results_list[[cluster]] <- medians %>%
    mutate(z_score = (median_value - overall_median) / (overall_mad + 0.00001)) %>%
    mutate(is_outlier = z_score > 2000)
}

outliers_df <- bind_rows(results_list, .id = "clusterName3")

PropCells_with_outliers <- PropCells_byRgn %>%
  left_join(outliers_df %>% select(clusterName3, RegionAcronym, is_outlier),
    by = c("clusterName3", "RegionAcronym")
  )

PropHeat_sig <- PropHeat +
  geom_text(
    data = PropCells_with_outliers %>% filter(is_outlier == TRUE),
    aes(label = "*"), color = "red", size = 3, vjust = 0.7
  )

PropHeat_sig
```
I tried once with:
overall_median <- median(cluster_data$Prop[cluster_data$Prop != 0]
but not very good, so first testing to only positive z-scores
that cleaned, but still didn't highlight some obvious clusters, so now have as

overall_median <- median(cluster_data$Prop)

depending on the z-score threshold it makes sense for some but not for others,
so have to think about best statistical way..

# ggpubr sig test
```{r}
metaStats <- metaToPlot %>%
  select(clusterName3, RegionAcronym, BirdID) %>%
  group_by(clusterName3) %>%
  mutate(ClstrCount = n()) %>%
  group_by(clusterName3, RegionAcronym, BirdID) %>%
  mutate(ClstrRgnNbyID = n()) %>%
  mutate(Prop = ClstrRgnNbyID / ClstrCount) %>%
  ungroup() %>%
  complete(clusterName3, nesting(RegionAcronym, BirdID), fill = list(Prop = 0)) %>%
  unique()

prop_plots <- ggboxplot(metaStats,
  x = "RegionAcronym", y = "Prop", color = "RegionAcronym",
  add = "jitter", legend = "none",
  facet.by = "clusterName3"
) +
  rotate_x_text(angle = 90) +
  geom_hline(yintercept = mean(metaStats$Prop), linetype = 2) + # Add horizontal line at base mean
  stat_compare_means(method = "anova", label = "p.signif", label.y = 0.4, color = "darkred") + # Add global annova p-value
  stat_compare_means(
    label = "p.signif", method = "wilcox.test",
    ref.group = ".all.", hide.ns = T,
    label.y = 0.45,
    method.args = list(alternative = "greater")
  )

ggsave(
  filename = paste0(Figures_dir, "/FigS1/cluster_props.tiff"), plot = prop_plots,
  bg = NA, width = heightUse * 2, height = heightUse * 2
)
```


